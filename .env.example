# Get a key at https://agent.tinyfish.ai/  (Search + Fetch are free)
TINYFISH_API_KEY=your_key_here
# Leave TINYFISH_API_KEY unset to run on bundled sample data (offline demo mode)
# Your own estimate of one Agent run, used only for the cost report (USD)
AGENT_COST_PER_RUN_USD=0.05
CACHE_TTL_HOURS=24
MAX_AGENT_RUNS_PER_QUERY=6
